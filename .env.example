# Environment variables for EvidenceOps.
# Copy this file to `.env` and adjust values. A fresh installation runs with
# SQLite and the deterministic Mock provider without any of these variables.

# ── Persistence ─────────────────────────────────────────────────────────────
# memory | sqlite | postgres. Development API defaults to memory; the installed
# application defaults to SQLite and manages storage in the web console.
EVIDENCEOPS_PERSISTENCE=memory

# PostgreSQL connection (only needed when EVIDENCEOPS_PERSISTENCE=postgres).
# compose.yaml fails to start without POSTGRES_PASSWORD:
#   POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?请在.env中设置数据库密码}
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=evidenceops
POSTGRES_USER=evidenceops

# ── Diagnosis model (default mock; everything runs without credentials) ────
# mock | openai-compatible
EVIDENCEOPS_PROVIDER=mock
EVIDENCEOPS_MODEL_BASE_URL=
EVIDENCEOPS_MODEL_API_KEY=
EVIDENCEOPS_MODEL_NAME=
EVIDENCEOPS_MODEL_TIMEOUT_SECONDS=60
# Allowed provider hosts, comma separated. Extend for self-hosted services.
EVIDENCEOPS_MODEL_ALLOWED_HOSTS=maas.qianwenaiapi.com,dashscope.aliyuncs.com
# Explicit opt-in for HTTP (non-TLS) provider endpoints; leave unset.
EVIDENCEOPS_MODEL_ALLOW_HTTP=

# ── Context budget (defaults shown; see README "Context window") ───────────
EVIDENCEOPS_CONTEXT_WINDOW_TOKENS=32768
EVIDENCEOPS_MAX_OUTPUT_TOKENS=2048
EVIDENCEOPS_CONTEXT_SAFETY_MARGIN_TOKENS=256
EVIDENCEOPS_MAX_RUN_TOKENS=16384
EVIDENCEOPS_RUN_TIMEOUT_SECONDS=180

# ── Knowledge retrieval (disabled by default) ───────────────────────────────
# When enabling, run `alembic upgrade head` first and fill all EMBEDDING_* fields.
EVIDENCEOPS_KNOWLEDGE_ENABLED=false
EVIDENCEOPS_KNOWLEDGE_DOCUMENT_IDS=
# cosine | keyword | bm25 | hybrid | hybrid_bm25
EVIDENCEOPS_KNOWLEDGE_RETRIEVAL=cosine
EMBEDDING_PROVIDER=
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=

# ── Log evidence tool (optional; both fields required together) ─────────────
# EVIDENCEOPS_LOG_SOURCES_FILE points at a server-managed JSON manifest;
# EVIDENCEOPS_LOG_PARSER_BINARY is the compiled C++20 parser executable.
EVIDENCEOPS_LOG_SOURCES_FILE=
EVIDENCEOPS_LOG_PARSER_BINARY=

# ── Advanced (defaults are sane; rarely changed) ────────────────────────────
EVIDENCEOPS_TOKEN_ESTIMATOR_ID=heuristic-json-v1
EVIDENCEOPS_CONTEXT_LIMITS_SOURCE=local_conservative
EVIDENCEOPS_CONNECTIONS_DIR=
EVIDENCEOPS_CONNECTIONS_KEY=
