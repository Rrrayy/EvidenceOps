# PyCharm / IntelliJ
.idea/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Pytest and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test coverage
.coverage
coverage.xml
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build and package outputs
build/
dist/
*.egg-info/

# Operating-system files
Thumbs.db
.DS_Store

# Next.js console dependencies and generated artifacts
frontend/node_modules/
frontend/.next/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
output/
.playwright-cli/

# Internal Markdown notes: ignored by default; published documents are whitelisted explicitly
*.md
!/samples/knowledge/*.md
!/README.md
!/README.zh-CN.md
!/frontend/MODEL_CONNECTIONS_CONTRACT.md
!/frontend/FRONTEND_TEST_REPORT.md
!/CUSTOMER_INSTALLATION.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/CHANGELOG.md
!/docs/**/*.md
!.github/**/*.md
